# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- Postgres (read by the postgres container) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- Backend (api + worker) ---
# Hostnames are compose service names; use localhost when running outside compose.
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/app
REDIS_URL=redis://redis:6379/0

# --- Featherless LLM (every call goes through backend/llm) ---
FEATHERLESS_API_KEY=

# Model per slot. Code only refers to slots, so switching models is an env change.
# Not plain DeepSeek-V4-Flash: on Featherless (2026-10-30) it drops the first output token
# (e.g. the opening '{' of JSON). The -0731 build has the same price and works.
FEATHERLESS_MODEL_GENERATOR=deepseek-ai/DeepSeek-V4-Flash-0731
FEATHERLESS_MODEL_ASSISTANT=deepseek-ai/DeepSeek-V4-Flash-0731
# For final calibration and the demo, switch the probe to
# Qwen/Qwen3-Coder-480B-A35B-Instruct and its prices to 0.38 / 1.55.
FEATHERLESS_MODEL_PROBE=Qwen/Qwen3-Coder-30B-A3B-Instruct
# Small and fast: one short JSON decision per interview turn (docs/INTERVIEWER.md).
# Not meta-llama/*: gated on Featherless (403 model_gated_needs_oauth without HF OAuth).
# Provisional until the model comparison in P4.9 is recorded in docs/PROGRESS.md.
FEATHERLESS_MODEL_INTERVIEWER=Qwen/Qwen2.5-7B-Instruct

# Prices in USD per 1M tokens (Featherless /v1/models), for the spend estimate.
FEATHERLESS_PRICE_IN_GENERATOR=0.14
FEATHERLESS_PRICE_OUT_GENERATOR=0.28
FEATHERLESS_PRICE_IN_ASSISTANT=0.14
FEATHERLESS_PRICE_OUT_ASSISTANT=0.28
FEATHERLESS_PRICE_IN_PROBE=0.125
FEATHERLESS_PRICE_OUT_PROBE=0.45
FEATHERLESS_PRICE_IN_INTERVIEWER=0.17
FEATHERLESS_PRICE_OUT_INTERVIEWER=0.20

# Reasoning control per slot, sent as Featherless chat_template_kwargs (JSON).
# DeepSeek V4: thinking off. Qwen3-Coder has no thinking mode, so nothing to send.
FEATHERLESS_CHAT_TEMPLATE_KWARGS_GENERATOR={"thinking":false}
FEATHERLESS_CHAT_TEMPLATE_KWARGS_ASSISTANT={"thinking":false}
FEATHERLESS_CHAT_TEMPLATE_KWARGS_PROBE={}
# Qwen2.5 has no thinking mode.
FEATHERLESS_CHAT_TEMPLATE_KWARGS_INTERVIEWER={}

# --- Interviewer voice (Featherless POST /v1/audio/speech) ---
# Voices for a model: GET /v1/audio/voices. Kokoro returns WAV (no transcoding).
FEATHERLESS_TTS_MODEL=hexgrad/Kokoro-82M
FEATHERLESS_TTS_VOICE=af_bella
# Max LLM tokens per interview; over budget the interviewer goes scripted-only.
INTERVIEW_TOKEN_BUDGET=4000

# --- LLM client ---
LLM_TIMEOUT_S=60
# Retries on network errors, HTTP 429 and 5xx, with exponential backoff.
LLM_MAX_RETRIES=3
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_S=604800
# Hard limit on estimated spend. Once reached, only cached responses are served.
LLM_BUDGET_USD=20

# --- Frontend ---
# Set by docker-compose.yml; only needed when running the frontend outside compose.
# API_URL=http://localhost:8000
# Base URL `make seed-demo` prints session links with.
# FRONTEND_URL=http://localhost:3000

# --- Platform links (frontend nav; read when the frontend starts) ---
# NEXT_PUBLIC_SHOWCASE_URL=http://localhost:3001
# NEXT_PUBLIC_CODE_READING_URL=http://localhost:3002

# --- Recruiter routes (Trail Map; recruiter page in F1) ---
# Sent by the recruiter as the X-Recruiter-Key header; unset: recruiter routes return 503.
RECRUITER_API_KEY=
